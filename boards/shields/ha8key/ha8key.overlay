#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &ha8key_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <8>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3)
RC(0,4) RC(0,5) RC(0,6) RC(0,7)
        >;
    };

    ha8key_layout: ha8key_layout {
        compatible = "zmk,physical-layout";
        display-name = "HA 8-Key";
        kscan = <&kscan0>;
        transform = <&default_transform>;
           keys
            = <&key_physical_attrs 100 100   0   0 0 0 0>
            , <&key_physical_attrs 100 100 110   0 0 0 0>
            , <&key_physical_attrs 100 100 220   0 0 0 0>
            , <&key_physical_attrs 100 100  55 105 0 0 0>
            , <&key_physical_attrs 100 100 165 105 0 0 0>
            , <&key_physical_attrs 100 100   0 210 0 0 0>
            , <&key_physical_attrs 100 100 110 210 0 0 0>
            , <&key_physical_attrs 100 100 220 210 0 0 0>
            ;         
    };
};
